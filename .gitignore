# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.prod.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite database files
*.db
*.db-journal

# terraform — infra/<provider>/ (one root per cloud: oracle, gcp, ...).
# .terraform.lock.hcl IS committed in each provider dir — pins provider versions.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/*.auto.tfvars
