# Copie para .env (gitignored) e preencha. O provider "google" do
# Terraform lê essas variáveis de ambiente automaticamente — nenhuma
# credencial fica em arquivo .tf/.tfvars versionado.
#
# Como carregar antes de rodar terraform:
#   PowerShell:
#     Get-Content .env | ForEach-Object {
#       if ($_ -match '^\s*([^#=]+)=(.*)$') {
#         [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim())
#       }
#     }
#   bash:
#     set -a; source .env; set +a
#
# Ver ../../docs/deploy-gcp.md pra como gerar a service account key.

# Caminho local do JSON da service account (IAM & Admin > Service Accounts
# > Keys > Add Key > JSON). NUNCA commitar esse arquivo.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/seu-usuario/.gcp/animebattler-sa.json

# ID do projeto GCP (não o nome — o "Project ID" que aparece no console)
GOOGLE_PROJECT=animebattler-123456

# Região default (deve combinar com infra/gcp/variables.tf)
GOOGLE_REGION=us-central1
