// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

model Transformation {
  id               String                @id @default(cuid())
  character        Character             @relation(fields: [characterId], references: [id])
  characterId      String
  name             String
  description      String?
  levelRequirement Int                   @default(1)
  energyModifier   Float                 @default(0) // percentage delta e.g. 0.15 for +15%
  attackModifier   Float                 @default(0)
  defenseModifier  Float                 @default(0)
  speedModifier    Float                 @default(0)
  flatHpBonus      Int                   @default(0)
  flatAttackBonus  Int                   @default(0)
  flatDefenseBonus Int                   @default(0)
  flatSpeedBonus   Int                   @default(0)
  drainPerTurn     Int                   @default(0) // energy drain each turn
  unlocksSkill     Skill?                @relation("TransformationUnlockSkill", fields: [unlocksSkillId], references: [id])
  unlocksSkillId   String?
  triggerType      TransformationTrigger @default(MANUAL)
  triggerPayload   Json?
  imageUrl         String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  userTransformations UserCharacterTransformation[]
  activeFor           UserCharacter[]               @relation("ActiveTransformation")

  @@index([characterId, levelRequirement])
}

model UserCharacterTransformation {
  id               String         @id @default(cuid())
  userCharacter    UserCharacter  @relation(fields: [userCharacterId], references: [id])
  userCharacterId  String
  transformation   Transformation @relation(fields: [transformationId], references: [id])
  transformationId String
  unlockedAt       DateTime       @default(now())
  unlockedAtLevel  Int

  @@unique([userCharacterId, transformationId])
}

enum TransformationTrigger {
  MANUAL
  LOW_HP
  ON_DAMAGE_TAKEN
  ENERGY_CHARGE
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Core domain for the game
model Anime {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  characters    Character[]
  affiliations  Affiliation[]
  storyChapters StoryChapter[]
  equipment     Equipment[]
}

model Affiliation {
  id         String      @id @default(cuid())
  name       String
  anime      Anime       @relation(fields: [animeId], references: [id])
  animeId    String
  characters Character[]

  @@unique([animeId, name])
}

model Character {
  id            String       @id @default(cuid())
  name          String
  slug          String?      @unique
  imageUrl      String?
  description   String?
  anime         Anime        @relation(fields: [animeId], references: [id])
  animeId       String
  affiliation   Affiliation? @relation(fields: [affiliationId], references: [id])
  affiliationId String?

  // Base stats
  hp      Int @default(100)
  attack  Int @default(10)
  defense Int @default(10)
  speed   Int @default(10)
  energy  Int @default(100)

  // Relations
  characterSkills CharacterSkill[]
  treeNodes       SkillTreeNode[]
  userCharacters  UserCharacter[]
  enemyBattles    Battle[]         @relation("EnemyCharacter")
  transformations Transformation[]
  storyStages     StoryStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animeId, name])
}

enum SkillCategory {
  NINJUTSU
  GENJUTSU
  TAIJUTSU
  HADO
  BAKUDO
  KIDO
  KI
  OTHER
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    SkillCategory
  power       Int           @default(10) // base multiplier or flat power
  energyCost  Int           @default(10)
  cooldown    Int           @default(0)
  tags        Json // JSON array of strings, e.g., ["bleed", "stun", "fire"] - flavor only
  effects     Json          @default("[]") // JSON array of SkillEffect (see app/lib/battle/types.ts) - mechanical source of truth

  // Ownership is many-to-many with characters
  characterLinks           CharacterSkill[]
  // Back-relations
  treeNodes                SkillTreeNode[]
  turns                    Turn[]
  grantedByTransformations Transformation[]             @relation("TransformationUnlockSkill")
  monsterLinks             MonsterSkill[]
  equippedBy               UserCharacterEquippedSkill[]
  grantedTo                UserCharacterSkill[]
  grantedByEquipment       Equipment[]                  @relation("EquipmentGrantedSkill")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category])
}

/// Enemy for raid battles (app/lib/battle/actions.ts's startRaidBattle) and
/// story-mode stages (StoryStage.enemyMonster).
model Monster {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  imageUrl      String?
  tier          Int            @default(1) // future difficulty/progression gate
  hp            Int            @default(100)
  attack        Int            @default(10)
  defense       Int            @default(10)
  speed         Int            @default(10)
  energy        Int            @default(100)
  monsterSkills MonsterSkill[]
  battles       Battle[]
  storyStages   StoryStage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model MonsterSkill {
  id        String  @id @default(cuid())
  monster   Monster @relation(fields: [monsterId], references: [id])
  monsterId String
  skill     Skill   @relation(fields: [skillId], references: [id])
  skillId   String

  @@unique([monsterId, skillId])
}

model CharacterSkill {
  // Join table for Character <-> Skill with extra metadata
  id               String    @id @default(cuid())
  character        Character @relation(fields: [characterId], references: [id])
  characterId      String
  skill            Skill     @relation(fields: [skillId], references: [id])
  skillId          String
  requiredLevel    Int       @default(1)
  learnedByDefault Boolean   @default(false)

  @@unique([characterId, skillId])
}

model SkillTreeNode {
  id          String    @id @default(cuid())
  character   Character @relation(fields: [characterId], references: [id])
  characterId String
  // A node may unlock a Skill or be a passive stat node
  skill       Skill?    @relation(fields: [skillId], references: [id])
  skillId     String?
  name        String
  description String?
  tier        Int       @default(1)
  pointCost   Int       @default(1)

  // Flat stat bonuses applied while unlocked (for nodes with no skillId, i.e. pure stat nodes)
  flatHpBonus      Int @default(0)
  flatAttackBonus  Int @default(0)
  flatDefenseBonus Int @default(0)
  flatSpeedBonus   Int @default(0)

  // Self-referential many-to-many for prerequisites
  prerequisites SkillTreeNode[] @relation("Prerequisites")
  unlocks       SkillTreeNode[] @relation("Prerequisites")

  userUnlocks UserSkillUnlock[]

  @@index([characterId, tier])
}

model User {
  id                  String              @id @default(cuid())
  username            String              @unique @default("devuser")
  email               String              @unique
  name                String?
  passwordHash        String // Simple auth placeholder; swap to Auth.js later
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  characters          UserCharacter[]
  battles             Battle[]
  role                UserRole            @default(USER)
  // Currently selected character for dashboard
  selectedCharacter   UserCharacter?      @relation("SelectedCharacter", fields: [selectedCharacterId], references: [id])
  selectedCharacterId String?
  sessions            Session[]
  storyProgress       UserStoryProgress[]
  equipment           UserEquipment[]
  // Carteira da conta, compartilhada entre todos os personagens do usuário.
  // Ganha no modo história; gasta na loja (ainda não implementada).
  coins               Int                 @default(0)
}

model UserCharacter {
  id                     String          @id @default(cuid())
  user                   User            @relation(fields: [userId], references: [id])
  userId                 String
  character              Character       @relation(fields: [characterId], references: [id])
  characterId            String
  level                  Int             @default(1)
  experience             Int             @default(0)
  pointsAvailable        Int             @default(0)
  nickname               String          @default("Hero")
  pvpWins                Int             @default(0)
  npcWins                Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  activeTransformation   Transformation? @relation("ActiveTransformation", fields: [activeTransformationId], references: [id])
  activeTransformationId String?

  skillUnlocks          UserSkillUnlock[]
  playerBattles         Battle[]                      @relation("PlayerCharacter")
  selectedBy            User[]                        @relation("SelectedCharacter")
  transformationUnlocks UserCharacterTransformation[]
  equippedSkills        UserCharacterEquippedSkill[]
  grantedSkills         UserCharacterSkill[]
  equipment             UserEquipment[]

  @@unique([userId, characterId])
}

model UserSkillUnlock {
  id              String        @id @default(cuid())
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  node            SkillTreeNode @relation(fields: [nodeId], references: [id])
  nodeId          String
  unlockedAt      DateTime      @default(now())

  @@unique([userCharacterId, nodeId])
}

/// Which of a UserCharacter's eligible skills are equipped for battle
/// (max slots enforced in app code via MAX_LOADOUT_SLOTS).
model UserCharacterEquippedSkill {
  id              String        @id @default(cuid())
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  skill           Skill         @relation(fields: [skillId], references: [id])
  skillId         String
  slot            Int

  @@unique([userCharacterId, skillId])
  @@unique([userCharacterId, slot])
}

enum BattleStatus {
  PENDING
  ACTIVE
  FINISHED
}

enum ActorSide {
  PLAYER
  ENEMY
}

model Battle {
  id                String        @id @default(cuid())
  user              User          @relation(fields: [userId], references: [id])
  userId            String
  playerCharacter   UserCharacter @relation("PlayerCharacter", fields: [playerCharacterId], references: [id])
  playerCharacterId String
  // Exactly one of enemyCharacter/enemyMonster is set - enforced in app code,
  // not the DB (SQLite has no simple declarative CHECK constraint here).
  enemyCharacter    Character?    @relation("EnemyCharacter", fields: [enemyCharacterId], references: [id])
  enemyCharacterId  String?
  enemyMonster      Monster?      @relation(fields: [enemyMonsterId], references: [id])
  enemyMonsterId    String?
  // Set when the battle was started from a story stage, so finishing it can
  // record progress. Null for AI/raid battles.
  storyStage        StoryStage?   @relation(fields: [storyStageId], references: [id])
  storyStageId      String?
  status            BattleStatus  @default(PENDING)
  turnNumber        Int           @default(1)
  // JSON state snapshot for current combat (HP, energy, effects)
  state             Json
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  turns Turn[]
}

model Turn {
  id        String    @id @default(cuid())
  battle    Battle    @relation(fields: [battleId], references: [id])
  battleId  String
  number    Int
  actor     ActorSide
  skill     Skill?    @relation(fields: [skillId], references: [id])
  skillId   String?
  result    Json // damage dealt, effects applied, crits, etc.
  createdAt DateTime  @default(now())

  @@index([battleId, number])
}

model Session {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Modo história: capítulos lineares de um anime, cada um com estágios
/// ordenados. Um estágio é uma batalha roteirizada com narrativa antes e
/// depois, liberado só quando o anterior foi concluído.
model StoryChapter {
  id          String       @id @default(cuid())
  anime       Anime        @relation(fields: [animeId], references: [id])
  animeId     String
  slug        String       @unique
  title       String
  description String?
  order       Int
  stages      StoryStage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([animeId, order])
}

model StoryStage {
  id        String       @id @default(cuid())
  chapter   StoryChapter @relation(fields: [chapterId], references: [id])
  chapterId String
  order     Int
  title     String

  // Narrativa exibida antes da batalha e depois da vitória.
  introText String
  outroText String

  // Exatamente um dos dois é preenchido — mesma convenção do model Battle,
  // garantida no código da aplicação e não por constraint declarativa.
  enemyCharacter   Character? @relation(fields: [enemyCharacterId], references: [id])
  enemyCharacterId String?
  enemyMonster     Monster?   @relation(fields: [enemyMonsterId], references: [id])
  enemyMonsterId   String?
  // Escala o inimigo sem precisar de uma linha própria por dificuldade.
  enemyLevel       Int        @default(1)

  xpReward   Int @default(50)
  // Skill não é recompensa direta de estágio: elas vêm por nível (via
  // CharacterSkill.requiredLevel) ou são compradas. O estágio paga em moeda,
  // que é o que vai alimentar a loja.
  coinReward Int @default(0)

  progress UserStoryProgress[]
  battles  Battle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, order])
}

model UserStoryProgress {
  id          String     @id @default(cuid())
  user        User       @relation(fields: [userId], references: [id])
  userId      String
  stage       StoryStage @relation(fields: [stageId], references: [id])
  stageId     String
  completedAt DateTime   @default(now())

  @@unique([userId, stageId])
  @@index([userId])
}

/// Skill que um UserCharacter específico ganhou fora do kit base e fora da
/// árvore — hoje, só como recompensa de estágio do modo história.
///
/// Precisa existir porque nenhum dos dois mecanismos anteriores serve: o
/// CharacterSkill pertence ao personagem do catálogo (concedê-la ali daria a
/// skill a todos os jogadores daquele personagem), e o UserSkillUnlock exige
/// um SkillTreeNode, que é modelado por personagem e não por recompensa.
model UserCharacterSkill {
  id              String        @id @default(cuid())
  userCharacter   UserCharacter @relation(fields: [userCharacterId], references: [id])
  userCharacterId String
  skill           Skill         @relation(fields: [skillId], references: [id])
  skillId         String
  source          String        @default("STORY")
  grantedAt       DateTime      @default(now())

  @@unique([userCharacterId, skillId])
  @@index([userCharacterId])
}

enum EquipmentSlot {
  ZANPAKUTO
  TRAJE
  ACESSORIO
}

/// Raridade é regra de jogo (limita o que a loja vende cedo) e também o
/// vocabulário visual da UI — cada nível tem sua cor e brilho.
enum EquipmentRarity {
  COMUM
  RARO
  EPICO
  LENDARIO
}

/// Item comprável na loja. É o primeiro sumidouro das moedas ganhas no modo
/// história — até aqui elas só acumulavam.
///
/// Os bônus de stat usam os mesmos nomes de campo do SkillTreeNode de
/// propósito: os dois são somados no mesmo ponto antes de virar os stats de
/// batalha (ver getEquipmentBonus/computeBaseStats), então manter o formato
/// idêntico evita conversão no meio.
model Equipment {
  id            String          @id @default(cuid())
  name          String          @unique
  description   String
  slot          EquipmentSlot
  rarity        EquipmentRarity @default(COMUM)
  price         Int
  /// Nível mínimo do personagem pra equipar (comprar é liberado antes).
  requiredLevel Int             @default(1)

  flatHpBonus      Int @default(0)
  flatAttackBonus  Int @default(0)
  flatDefenseBonus Int @default(0)
  flatSpeedBonus   Int @default(0)

  /// Skill que o item concede enquanto equipado. Ela NÃO ocupa um dos 4
  /// slots do loadout: entra na batalha por cima deles (ver
  /// getEquippedSkills), que é o que dá peso a equipar um Zanpakutō.
  grantedSkill   Skill?  @relation("EquipmentGrantedSkill", fields: [grantedSkillId], references: [id])
  grantedSkillId String?

  /// Item é temático de um anime; null = genérico, serve pra qualquer um.
  anime   Anime?  @relation(fields: [animeId], references: [id])
  animeId String?

  imageUrl String?

  ownedBy UserEquipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot])
}

/// Um item comprado. A compra é da CONTA (assim como as moedas), e o item é
/// equipado em um personagem por vez — comprar a Zangetsu uma vez e poder
/// trocá-la entre personagens é o comportamento esperado de inventário.
///
/// `slot` é copiado do Equipment pra que a unicidade "um item por slot por
/// personagem" possa ser garantida pelo banco. No Postgres, NULL não colide
/// em índice único, então vários itens desequipados (equippedOnId = null)
/// convivem sem problema.
model UserEquipment {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id])
  equipmentId String
  slot        EquipmentSlot

  equippedOn   UserCharacter? @relation(fields: [equippedOnId], references: [id])
  equippedOnId String?

  purchasedAt DateTime @default(now())

  @@unique([userId, equipmentId])
  @@unique([equippedOnId, slot])
  @@index([userId])
}
